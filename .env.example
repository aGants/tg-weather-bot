BOT_API_KEY=your_telegram_bot_token
NODE_ENV=development

# Только для продакшена (Render и т.п.): если задан WEBHOOK_URL,
# бот переключается с long-polling на webhook.
# На Render можно не задавать вручную — используется RENDER_EXTERNAL_URL.
# WEBHOOK_URL=https://your-app.onrender.com
# WEBHOOK_SECRET=some_random_string
